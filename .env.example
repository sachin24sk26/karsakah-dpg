# KARSAKAH Environment Configuration Example
# Copy this file to .env and insert your real keys

# Google Gemini Multi-Modal API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Host & Port Configuration
FLASK_ENV=development
PORT=5000

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://karsakah.vercel.app
